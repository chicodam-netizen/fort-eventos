APP_NAME="Grupo Forte - Gestão de Eventos"
DEBUG=false
# Banco local de desenvolvimento (Postgres 17 nativo, porta 5433, banco fort_eventos)
DATABASE_URL="postgresql://fort_eventos:<senha>@localhost:5433/fort_eventos"
JWT_SECRET_KEY="<gere com: python -c \"import secrets;print(secrets.token_urlsafe(48))\">"
FRONTEND_URL="http://localhost:5174"
# Identificação enviada ao Nominatim (OpenStreetMap) na busca de endereço
GEOCODER_USER_AGENT="GrupoForte-GestaoEventos/1.0"
